generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Permission {
  id       Int                         @id @default(autoincrement())
  code     String                      @unique
  label    String
  module   String
  groups   PermissionGroupPermission[]

  @@index([module])
  @@map("permissions")
}

model PermissionGroup {
  id          Int                         @id @default(autoincrement())
  name        String                      @unique
  code        String                      @unique
  description String?
  isSystem    Boolean                     @default(false) @map("is_system")
  createdAt   DateTime                    @default(now()) @map("created_at")
  updatedAt   DateTime                    @updatedAt @map("updated_at")
  permissions PermissionGroupPermission[]
  users       UserPermissionGroup[]

  @@map("permission_groups")
}

model PermissionGroupPermission {
  permissionGroupId Int @map("permission_group_id")
  permissionId      Int @map("permission_id")
  permissionGroup   PermissionGroup @relation(fields: [permissionGroupId], references: [id], onDelete: Cascade)
  permission        Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([permissionGroupId, permissionId])
  @@index([permissionId])
  @@map("permission_group_permissions")
}

model UserPermissionGroup {
  userId            Int @map("user_id")
  permissionGroupId Int @map("permission_group_id")
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionGroup   PermissionGroup @relation(fields: [permissionGroupId], references: [id], onDelete: Cascade)

  @@id([userId, permissionGroupId])
  @@index([permissionGroupId])
  @@map("user_permission_groups")
}

model User {
  id                   Int                 @id @default(autoincrement())
  email                String              @unique
  passwordHash         String              @map("password_hash")
  fullName             String              @map("full_name")
  code                 String              @unique
  role                 UserRole            @default(STUDENT)
  department           String?
  phone                String?
  avatarUrl            String?             @map("avatar_url")
  academicTitle        AcademicTitle?      @map("academic_title")
  isActive             Boolean             @default(true) @map("is_active")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  councilMembers       CouncilMember[]
  defenseResults       DefenseResult[]     @relation("DefenseEvaluator")
  lockedDefenseResults DefenseResult[]     @relation("DefenseScoreLocker")
  evaluatedMemberScores DefenseMemberScore[] @relation("DefenseMemberScoreEvaluator")
  lockedMemberScores   DefenseMemberScore[] @relation("DefenseMemberScoreLocker")
  notifications        Notification[]
  submissions          Submission[]
  mentoredTopics       Topic[]             @relation("MentoredBy")
  proposedTopics       Topic[]             @relation("ProposedBy")
  registrations        TopicRegistration[]
  projectEnrollments   StudentProjectEnrollment[]
  auditLogs            AuditLog[]
  permissionGroups     UserPermissionGroup[]
  announcements        PublicAnnouncement[]
  meetingLogsCreated   MeetingLog[]
  reviewedArchives     ProjectArchive[]

  @@map("users")
}

model Semester {
  id                   Int            @id @default(autoincrement())
  name                 String
  startDate            DateTime       @map("start_date")
  endDate              DateTime       @map("end_date")
  registrationDeadline DateTime?      @map("registration_deadline")
  midtermReportDate    DateTime?      @map("midterm_report_date")
  defenseDate          DateTime?      @map("defense_date")
  registrationOpen     Boolean        @default(true) @map("registration_open")
  status               SemesterStatus @default(UPCOMING)
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  councils             Council[]
  topics               Topic[]
  projectEnrollments   StudentProjectEnrollment[]

  @@map("semesters")
}

model Topic {
  id            Int                 @id @default(autoincrement())
  semesterId    Int                 @map("semester_id")
  projectCatalogId Int?             @map("project_catalog_id")
  title         String
  description   String?
  proposedById  Int                 @map("proposed_by_id")
  mentorId      Int                 @map("mentor_id")
  maxStudents   Int                 @default(1) @map("max_students")
  status        TopicStatus         @default(PENDING)
  rejectReason  String?             @map("reject_reason")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  mentor        User                @relation("MentoredBy", fields: [mentorId], references: [id])
  proposedBy    User                @relation("ProposedBy", fields: [proposedById], references: [id])
  semester      Semester            @relation(fields: [semesterId], references: [id])
  projectCatalog ProjectCatalog?    @relation(fields: [projectCatalogId], references: [id])
  registrations TopicRegistration[]

  @@map("topics")
}

model TopicRegistration {
  id            Int                @id @default(autoincrement())
  topicId       Int                @map("topic_id")
  studentId     Int                @map("student_id")
  semesterId          Int                  @map("semester_id")
  status              RegistrationStatus   @default(PENDING)
  rejectReason        String?              @map("reject_reason")
  councilId           Int?                 @map("council_id")
  outlineCouncilId    Int?                 @map("outline_council_id")
  defenseCouncilId    Int?                 @map("defense_council_id")
  outlineReviewStatus OutlineReviewStatus? @default(PENDING) @map("outline_review_status")
  outlineFeedback     String?              @map("outline_feedback")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  topic               Topic                @relation(fields: [topicId], references: [id])
  student             User                 @relation(fields: [studentId], references: [id])
  council             Council?             @relation("CouncilLegacy", fields: [councilId], references: [id])
  outlineCouncil      Council?             @relation("OutlineCouncil", fields: [outlineCouncilId], references: [id])
  defenseCouncil      Council?             @relation("DefenseCouncil", fields: [defenseCouncilId], references: [id])
  submissions   Submission[]
  tasks         Task[]
  meetingLogs   MeetingLog[]
  defenseResult DefenseResult?
  memberScores  DefenseMemberScore[]
  archive       ProjectArchive?

  @@unique([studentId, semesterId])
  @@map("topic_registrations")
}

model MeetingLog {
  id                 Int               @id @default(autoincrement())
  registrationId     Int               @map("registration_id")
  meetingDate        DateTime          @default(now()) @map("meeting_date")
  meetingType        String            @default("LAB") @map("meeting_type")
  studentWorkSummary String            @db.Text @map("student_work_summary")
  nextPlan           String?           @db.Text @map("next_plan")
  supervisorNotes    String?           @db.Text @map("supervisor_notes")
  createdBy          Int               @map("created_by")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  registration       TopicRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  creator            User              @relation(fields: [createdBy], references: [id])

  @@index([registrationId, meetingDate])
  @@map("meeting_logs")
}

model ProjectArchive {
  id             Int               @id @default(autoincrement())
  registrationId Int               @unique @map("registration_id")
  reportFileUrl  String?           @map("report_file_url")
  reportFileName String?           @map("report_file_name")
  slideFileUrl   String?           @map("slide_file_url")
  slideFileName  String?           @map("slide_file_name")
  sourceCodeUrl  String?           @map("source_code_url")
  demoVideoUrl   String?           @map("demo_video_url")
  bm03FileUrl    String?           @map("bm03_file_url")
  bm04FileUrl    String?           @map("bm04_file_url")
  summary        String?           @db.Text
  status         ArchiveStatus     @default(SUBMITTED)
  reviewedBy     Int?              @map("reviewed_by")
  reviewerNotes  String?           @db.Text @map("reviewer_notes")
  submittedAt    DateTime          @default(now()) @map("submitted_at")
  reviewedAt     DateTime?         @map("reviewed_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  registration   TopicRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  reviewer       User?             @relation(fields: [reviewedBy], references: [id])

  @@map("project_archives")
}

model Task {
  id             Int               @id @default(autoincrement())
  registrationId Int               @map("registration_id")
  title          String
  content        String?
  taskType       TaskType          @default(GENERIC) @map("task_type")
  dueDate        DateTime?         @map("due_date")
  status         TaskStatus        @default(OPEN)
  isBypassed     Boolean           @default(false) @map("is_bypassed")
  bypassReason   String?           @map("bypass_reason")
  bypassedBy     Int?              @map("bypassed_by")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  submissions    Submission[]
  registration   TopicRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

model Submission {
  id             Int               @id @default(autoincrement())
  taskId         Int               @map("task_id")
  registrationId Int               @map("registration_id")
  submittedBy    Int               @map("submitted_by")
  content        String?
  fileUrl        String?           @map("file_url")
  fileName       String?           @map("file_name")
  submittedAt    DateTime          @default(now()) @map("submitted_at")
  feedback       String?
  feedbackAt     DateTime?         @map("feedback_at")
  student        User              @relation(fields: [submittedBy], references: [id])
  task           Task              @relation(fields: [taskId], references: [id])
  registration   TopicRegistration @relation(fields: [registrationId], references: [id])

  @@map("submissions")
}

model Council {
  id            Int                 @id @default(autoincrement())
  semesterId    Int                 @map("semester_id")
  name          String
  councilType   CouncilType         @default(DEFENSE_COUNCIL) @map("council_type")
  location      String?
  defenseDate   DateTime?           @map("defense_date")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  members              CouncilMember[]
  semester             Semester            @relation(fields: [semesterId], references: [id])
  registrations        TopicRegistration[] @relation("CouncilLegacy")
  outlineRegistrations TopicRegistration[] @relation("OutlineCouncil")
  defenseRegistrations TopicRegistration[] @relation("DefenseCouncil")

  @@map("councils")
}

model CouncilMember {
  id            Int         @id @default(autoincrement())
  councilId     Int         @map("council_id")
  lecturerId    Int         @map("lecturer_id")
  roleInCouncil CouncilRole @map("role_in_council")
  council       Council     @relation(fields: [councilId], references: [id])
  lecturer      User        @relation(fields: [lecturerId], references: [id])

  @@unique([councilId, lecturerId])
  @@map("council_members")
}

model DefenseResult {
  id                 Int                     @id @default(autoincrement())
  registrationId     Int                     @unique @map("registration_id")
  finalScore         Float?                  @map("final_score")
  comments           String?
  scoresheetUrl      String?                 @map("scoresheet_url")
  scoreRubricVersion String                  @default("v1") @map("score_rubric_version")
  scoreLocked        Boolean                 @default(false) @map("score_locked")
  lockedAt           DateTime?               @map("locked_at")
  lockedBy           Int?                    @map("locked_by")
  pdfUrl             String?                 @map("pdf_url")
  pdfGeneratedAt     DateTime?               @map("pdf_generated_at")
  evaluatorId        Int                     @map("evaluator_id")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  registration       TopicRegistration       @relation(fields: [registrationId], references: [id])
  evaluator          User                    @relation("DefenseEvaluator", fields: [evaluatorId], references: [id])
  lockedByUser       User?                   @relation("DefenseScoreLocker", fields: [lockedBy], references: [id])
  criterionScores    DefenseCriterionScore[]

  @@map("defense_results")
}

model DefenseMemberScore {
  id                 Int                            @id @default(autoincrement())
  registrationId     Int                            @map("registration_id")
  evaluatorId        Int                            @map("evaluator_id")
  finalScore         Float?                         @map("final_score")
  comments           String?
  scoreRubricVersion String                         @default("v1") @map("score_rubric_version")
  scoreLocked        Boolean                        @default(false) @map("score_locked")
  lockedAt           DateTime?                      @map("locked_at")
  lockedBy           Int?                           @map("locked_by")
  pdfUrl             String?                        @map("pdf_url")
  pdfGeneratedAt     DateTime?                      @map("pdf_generated_at")
  createdAt          DateTime                       @default(now()) @map("created_at")
  updatedAt          DateTime                       @updatedAt @map("updated_at")
  registration       TopicRegistration              @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  evaluator          User                           @relation("DefenseMemberScoreEvaluator", fields: [evaluatorId], references: [id])
  lockedByUser       User?                          @relation("DefenseMemberScoreLocker", fields: [lockedBy], references: [id])
  criterionScores    DefenseMemberCriterionScore[]

  @@unique([registrationId, evaluatorId])
  @@map("defense_member_scores")
}

model DefenseMemberCriterionScore {
  id                 Int               @id @default(autoincrement())
  defenseMemberScoreId Int             @map("defense_member_score_id")
  criterionCode      String            @map("criterion_code")
  criterionLabel     String            @map("criterion_label")
  maxScore           Float             @map("max_score")
  score              Float
  comment            String?
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  defenseMemberScore DefenseMemberScore @relation(fields: [defenseMemberScoreId], references: [id], onDelete: Cascade)

  @@unique([defenseMemberScoreId, criterionCode])
  @@map("defense_member_criterion_scores")
}

model DefenseCriterionScore {
  id              Int           @id @default(autoincrement())
  defenseResultId Int           @map("defense_result_id")
  criterionCode   String        @map("criterion_code")
  criterionLabel  String        @map("criterion_label")
  maxScore        Float         @map("max_score")
  score           Float
  comment         String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  defenseResult   DefenseResult @relation(fields: [defenseResultId], references: [id], onDelete: Cascade)

  @@unique([defenseResultId, criterionCode])
  @@map("defense_criterion_scores")
}

model Notification {
  id           Int              @id @default(autoincrement())
  userId       Int              @map("user_id")
  title        String
  content      String
  type         NotificationType @default(SYSTEM)
  referenceUrl String?          @map("reference_url")
  isRead       Boolean          @default(false) @map("is_read")
  createdAt    DateTime         @default(now()) @map("created_at")
  user         User             @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  details    Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([action, entityType, createdAt])
  @@map("audit_logs")
}

model ProjectCatalog {
  id               Int                        @id @default(autoincrement())
  code             String                     @unique
  name             String
  isActive         Boolean                    @default(true) @map("is_active")
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")
  topics           Topic[]
  enrollments      StudentProjectEnrollment[]

  @@map("project_catalogs")
}

model StudentProjectEnrollment {
  id               Int                            @id @default(autoincrement())
  studentId        Int                            @map("student_id")
  semesterId       Int                            @map("semester_id")
  projectCatalogId Int                            @map("project_catalog_id")
  status           StudentProjectEnrollmentStatus @default(ACTIVE)
  source           EnrollmentSource               @default(SEED)
  importBatchId    String?                        @map("import_batch_id")
  createdAt        DateTime                       @default(now()) @map("created_at")
  updatedAt        DateTime                       @updatedAt @map("updated_at")
  student          User                           @relation(fields: [studentId], references: [id])
  semester         Semester                       @relation(fields: [semesterId], references: [id])
  projectCatalog   ProjectCatalog                 @relation(fields: [projectCatalogId], references: [id])

  @@unique([studentId, semesterId, projectCatalogId])
  @@index([studentId, semesterId, status])
  @@map("student_project_enrollments")
}

model PublicAnnouncement {
  id          Int      @id @default(autoincrement())
  title       String
  content     String?  @db.Text
  category    String?  @default("ANNOUNCEMENT")
  fileUrl     String?  @map("file_url")
  fileName    String?  @map("file_name")
  isPinned    Boolean  @default(false) @map("is_pinned")
  isPublished Boolean  @default(true) @map("is_published")
  authorId    Int?     @map("author_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  author      User?    @relation(fields: [authorId], references: [id])

  @@map("public_announcements")
}

enum UserRole {
  ADMIN
  LECTURER
  STUDENT
}

enum AcademicTitle {
  THAC_SI
  TIEN_SI
  PHO_GIAO_SU
}

enum SemesterStatus {
  UPCOMING
  REGISTRATION
  ONGOING
  DEFENSE
  COMPLETED
}

enum TopicStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  IN_PROGRESS
  SUBMITTED
  DEFENDED
  COMPLETED
  DROPPED
  WITHDRAWN
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  SUBMITTED
  REVISION
  COMPLETED
  OVERDUE
}

enum CouncilRole {
  CHAIRMAN
  SECRETARY
  REVIEWER
  MEMBER
}

enum NotificationType {
  SYSTEM
  TASK_REMINDER
  APPROVAL
  REGISTRATION
  SUBMISSION
  DEFENSE
}

enum StudentProjectEnrollmentStatus {
  ACTIVE
  CANCELLED
}

enum EnrollmentSource {
  SEED
  MANUAL
  EXCEL
}

enum TaskType {
  BM01
  BM02
  BM03_CHECKPOINT_1
  BM03_CHECKPOINT_2
  BM03_CHECKPOINT
  REPORT_DRAFT
  BM04
  GENERIC
}

enum CouncilType {
  OUTLINE_REVIEW
  DEFENSE_COUNCIL
}

enum OutlineReviewStatus {
  PENDING
  PASSED
  REVISION_REQUIRED
  FAILED
}

enum ArchiveStatus {
  SUBMITTED
  APPROVED
  REVISION_REQUIRED
}
