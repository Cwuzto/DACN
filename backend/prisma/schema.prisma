generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Permission {
  id     Int                         @id @default(autoincrement())
  code   String                      @unique
  label  String
  module String
  groups PermissionGroupPermission[]

  @@index([module])
  @@map("permissions")
}

model PermissionGroup {
  id          Int                         @id @default(autoincrement())
  name        String                      @unique
  code        String                      @unique
  description String?
  isSystem    Boolean                     @default(false) @map("is_system")
  createdAt   DateTime                    @default(now()) @map("created_at")
  updatedAt   DateTime                    @updatedAt @map("updated_at")
  permissions PermissionGroupPermission[]
  users       UserPermissionGroup[]

  @@map("permission_groups")
}

model PermissionGroupPermission {
  permissionGroupId Int             @map("permission_group_id")
  permissionId      Int             @map("permission_id")
  permissionGroup   PermissionGroup @relation(fields: [permissionGroupId], references: [id], onDelete: Cascade)
  permission        Permission      @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([permissionGroupId, permissionId])
  @@index([permissionId])
  @@map("permission_group_permissions")
}

model UserPermissionGroup {
  userId            Int             @map("user_id")
  permissionGroupId Int             @map("permission_group_id")
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionGroup   PermissionGroup @relation(fields: [permissionGroupId], references: [id], onDelete: Cascade)

  @@id([userId, permissionGroupId])
  @@index([permissionGroupId])
  @@map("user_permission_groups")
}

model User {
  id                              Int                           @id @default(autoincrement())
  email                           String                        @unique
  passwordHash                    String                        @map("password_hash")
  fullName                        String                        @map("full_name")
  code                            String                        @unique
  role                            UserRole                      @default(STUDENT)
  department                      String?
  phone                           String?
  avatarUrl                       String?                       @map("avatar_url")
  academicTitle                   AcademicTitle?                @map("academic_title")
  isActive                        Boolean                       @default(true) @map("is_active")
  permissionVersion               Int                           @default(1) @map("permission_version")
  createdAt                       DateTime                      @default(now()) @map("created_at")
  updatedAt                       DateTime                      @updatedAt @map("updated_at")
  councilMembers                  CouncilMember[]
  defenseResults                  DefenseResult[]               @relation("DefenseEvaluator")
  lockedDefenseResults            DefenseResult[]               @relation("DefenseScoreLocker")
  evaluatedMemberScores           DefenseMemberScore[]          @relation("DefenseMemberScoreEvaluator")
  lockedMemberScores              DefenseMemberScore[]          @relation("DefenseMemberScoreLocker")
  notifications                   Notification[]
  submissions                     Submission[]
  mentoredTopics                  Topic[]                       @relation("MentoredBy")
  proposedTopics                  Topic[]                       @relation("ProposedBy")
  registrations                   TopicRegistration[]
  projectEnrollments              StudentProjectEnrollment[]
  studentProfile                  StudentProfile?
  auditLogs                       AuditLog[]
  permissionGroups                UserPermissionGroup[]
  announcements                   PublicAnnouncement[]
  meetingLogsCreated              MeetingLog[]
  reviewedArchives                ProjectArchive[]
  reviewedAdjustments             TopicTitleAdjustment[]        @relation("AdjustTitleReviewer")
  studentBM04                     BM04Evaluation[]              @relation("StudentBM04")
  lecturerBM04                    BM04Evaluation[]              @relation("LecturerBM04")
  createdRubrics                  RubricVersion[]               @relation("RubricCreator")
  registrationStateChanges        RegistrationStateHistory[]    @relation("RegistrationStateActor")
  createdWorkflowPolicies         PeriodWorkflowPolicyVersion[] @relation("WorkflowPolicyCreator")
  openedManualReviewCases         ManualReviewCase[]            @relation("ManualReviewOpenedBy")
  resolvedManualReviewCases       ManualReviewCase[]            @relation("ManualReviewResolvedBy")
  reviewedBM01Evaluations         BM01Evaluation[]              @relation("BM01ReviewedBy")
  submittedBM01Evaluations        BM01Evaluation[]              @relation("BM01SubmittedBy")
  reviewedRevisionBM01Evaluations BM01Evaluation[]              @relation("BM01RevisionReviewedBy")
  batchSecretaryCouncilBatches    CouncilResultBatch[]          @relation("BatchSecretary")
  batchChairCouncilBatches        CouncilResultBatch[]          @relation("BatchChair")
  batchReturnedCouncilBatches     CouncilResultBatch[]          @relation("BatchReturnedBy")
  batchReopenedCouncilBatches     CouncilResultBatch[]          @relation("BatchReopenedBy")
  submittedBM02Submissions        BM02Submission[]              @relation("BM02SubmittedBy")
  reviewedBM02Submissions         BM02Submission[]              @relation("BM02ReviewedBy")
  issuedAssignmentDecisions       AssignmentDecision[]          @relation("AssignmentDecisionIssuer")
  signedDecisionAmendments        DecisionAmendment[]           @relation("DecisionAmendmentSigner")
  checkpointMentorSignatures      CheckpointEvaluation[]        @relation("CheckpointMentorSignedBy")
  checkpointStudentSignatures     CheckpointEvaluation[]        @relation("CheckpointStudentSignedBy")
  checkpointAppealsSubmitted      CheckpointSignatureAppeal[]   @relation("CheckpointAppealStudent")
  checkpointAppealsReviewed       CheckpointSignatureAppeal[]   @relation("CheckpointAppealReviewedBy")
  transferredMentorshipsPrevious  MentorTransfer[]              @relation("PreviousMentor")
  transferredMentorshipsNew       MentorTransfer[]              @relation("NewMentor")
  transferredMentorshipsApproved  MentorTransfer[]              @relation("ApprovedMentorTransfer")
  approvedDefenseResults          DefenseResultApproval[]       @relation("DefenseResultApprovedBy")
  publishedResultPublications     ResultPublication[]           @relation("ResultPublicationPublishedBy")
  portalContentRevisionsCreated   PortalContentRevision[]       @relation("PortalContentRevisionCreatedBy")
  portalContentRevisionsPublished PortalContentRevision[]       @relation("PortalContentRevisionPublishedBy")
  delegatorDelegations            AcademicDelegation[]          @relation("DelegatorDelegations")
  delegateeDelegations            AcademicDelegation[]          @relation("DelegateeDelegations")
  lecturerProjectAssignments      LecturerProjectAssignment[]   @relation("LecturerAssignments")
  createdLecturerAssignments      LecturerProjectAssignment[]   @relation("AssignedByLecturerAssignments")
  electronicSignatures            ElectronicSignatureEvent[]    @relation("ElectronicSigner")
  issuedTopicAssignmentDecisions  TopicAssignmentDecision[]     @relation("TopicAssignmentDecisionIssuer")
  createdBM02ARequests            BM02AAdjustmentRequest[]      @relation("BM02ACreator")
  issuedTitleAdjustmentAppendices TitleAdjustmentAppendix[]     @relation("TitleAdjustmentAppendixIssuer")
  signedBM03ProgressRecords       BM03ProgressRecord[]          @relation("BM03AdvisorSigner")
  signedBM03MeetingEntries        BM03MeetingEntry[]            @relation("BM03MeetingAdvisorSigner")
  evaluatedBM03Stages             BM03StageEvaluation[]         @relation("BM03StageEvaluator")
  requestedMoreInfoStopReviews    InstituteStopReview[]         @relation("StopReviewMoreInfoRequester")
  reviewedStopReviews             InstituteStopReview[]         @relation("StopReviewer")
  requestedMoreInfoDefenseReviews InstituteDefenseReview[]      @relation("DefenseReviewMoreInfoRequester")
  reviewedDefenseReviews          InstituteDefenseReview[]      @relation("DefenseReviewer")

  @@map("users")
}

model StudentProfile {
  studentId   Int           @id @map("student_id")
  student     User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gender      StudentGender
  dateOfBirth DateTime      @map("date_of_birth") @db.Date
  className   String        @map("class_name")
  major       String
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("student_profiles")
}

enum StudentGender {
  MALE
  FEMALE
  OTHER
}

model Semester {
  id                     Int                           @id @default(autoincrement())
  code                   String                        @unique
  name                   String
  startDate              DateTime                      @map("start_date")
  endDate                DateTime                      @map("end_date")
  registrationDeadline   DateTime?                     @map("registration_deadline")
  midtermReportDate      DateTime?                     @map("midterm_report_date")
  defenseDate            DateTime?                     @map("defense_date")
  registrationOpen            Boolean                       @default(true) @map("registration_open")
  status                      SemesterStatus                @default(UPCOMING)
  outlineSubmissionOpenAt     DateTime?                     @map("outline_submission_open_at")
  outlineSubmissionDeadline   DateTime?                     @map("outline_submission_deadline")
  outlineTemplateFileUrl      String?                       @map("outline_template_file_url")
  outlineTemplateFileId       Int?                          @map("outline_template_file_id")
  outlineAllowedExtensions    Json                          @default("[\".docx\", \".pdf\"]") @map("outline_allowed_extensions")
  outlineMaxFileSizeBytes     Int                           @default(20971520) @map("outline_max_file_size_bytes")
  lockedPolicyVersionId       Int?                          @map("locked_policy_version_id")
  lockedPolicyVersion         PeriodWorkflowPolicyVersion?  @relation("SemesterLockedPolicy", fields: [lockedPolicyVersionId], references: [id], onDelete: Restrict)
  createdAt              DateTime                      @default(now()) @map("created_at")
  updatedAt              DateTime                      @updatedAt @map("updated_at")
  councils               Council[]
  topics                 Topic[]
  projectEnrollments     StudentProjectEnrollment[]
  bm04Evaluations        BM04Evaluation[]
  workflowPolicyVersions PeriodWorkflowPolicyVersion[]
  resultPublications     ResultPublication[]
  academicDelegations    AcademicDelegation[]
  lecturerAssignments    LecturerProjectAssignment[]
  topicAssignmentDecisions TopicAssignmentDecision[]

  @@map("semesters")
}

model AcademicDelegation {
  id             Int      @id @default(autoincrement())
  delegatorId    Int      @map("delegator_id")
  delegateeId    Int      @map("delegatee_id")
  capabilityCode String   @map("capability_code")
  department     String
  semesterId     Int?     @map("semester_id")
  effectiveFrom  DateTime @default(now()) @map("effective_from")
  effectiveTo    DateTime @map("effective_to")
  reason         String
  idempotencyKey String?  @unique @map("idempotency_key")
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  delegator User      @relation("DelegatorDelegations", fields: [delegatorId], references: [id])
  delegatee User      @relation("DelegateeDelegations", fields: [delegateeId], references: [id])
  semester  Semester? @relation(fields: [semesterId], references: [id])

  @@index([delegateeId, status, effectiveFrom, effectiveTo])
  @@map("academic_delegations")
}

model Topic {
  id               Int                 @id @default(autoincrement())
  semesterId       Int                 @map("semester_id")
  projectCatalogId Int?                @map("project_catalog_id")
  title            String
  description      String?
  proposedById     Int                 @map("proposed_by_id")
  mentorId         Int                 @map("mentor_id")
  maxStudents      Int                 @default(1) @map("max_students")
  status           TopicStatus         @default(PENDING)
  rejectReason     String?             @map("reject_reason")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  mentor           User                @relation("MentoredBy", fields: [mentorId], references: [id])
  proposedBy       User                @relation("ProposedBy", fields: [proposedById], references: [id])
  semester         Semester            @relation(fields: [semesterId], references: [id])
  projectCatalog   ProjectCatalog?     @relation(fields: [projectCatalogId], references: [id])
  registrations    TopicRegistration[]

  @@map("topics")
}

model TopicRegistration {
  id                         Int                          @id @default(autoincrement())
  topicId                    Int                          @map("topic_id")
  studentId                  Int                          @map("student_id")
  semesterId                 Int                          @map("semester_id")
  status                     RegistrationStatus           @default(PENDING)
  rejectReason               String?                      @map("reject_reason")
  councilId                  Int?                         @map("council_id")
  outlineCouncilId           Int?                         @map("outline_council_id")
  defenseCouncilId           Int?                         @map("defense_council_id")
  outlineReviewStatus        OutlineReviewStatus?         @default(PENDING) @map("outline_review_status")
  outlineFeedback            String?                      @map("outline_feedback")
  decisionNumber             String?                      @map("decision_number")
  decisionDate               DateTime?                    @map("decision_date")
  decisionPublishedAt        DateTime?                    @map("decision_published_at")
  bm01ApprovedTitleSnapshot  String?                      @map("bm01_approved_title_snapshot")
  adjustedTitle              String?                      @map("adjusted_title")
  assignmentStatus           MentorAssignmentStatus       @default(ACTIVE) @map("assignment_status")
  effectiveAt                DateTime                     @default(now()) @map("effective_at")
  cancelledAt                DateTime?                    @map("cancelled_at")
  createdAt                  DateTime                     @default(now()) @map("created_at")
  updatedAt                  DateTime                     @updatedAt @map("updated_at")
  topic                      Topic                        @relation(fields: [topicId], references: [id])
  student                    User                         @relation(fields: [studentId], references: [id])
  council                    Council?                     @relation("CouncilLegacy", fields: [councilId], references: [id])
  outlineCouncil             Council?                     @relation("OutlineCouncil", fields: [outlineCouncilId], references: [id])
  defenseCouncil             Council?                     @relation("DefenseCouncil", fields: [defenseCouncilId], references: [id])
  submissions                Submission[]
  tasks                      Task[]
  meetingLogs                MeetingLog[]
  defenseResult              DefenseResult?
  memberScores               DefenseMemberScore[]
  archive                    ProjectArchive?
  titleAdjustments           TopicTitleAdjustment[]
  bm04Evaluation             BM04Evaluation?
  stateVersion               Int                          @default(0) @map("state_version")
  periodPolicyVersionId      Int?                         @map("period_policy_version_id")
  periodPolicyVersion        PeriodWorkflowPolicyVersion? @relation(fields: [periodPolicyVersionId], references: [id], onDelete: Restrict)
  stateHistory               RegistrationStateHistory[]
  idempotencyRecords         IdempotencyRecord[]
  manualReviewCases          ManualReviewCase[]
  bm01Evaluations            BM01Evaluation[]
  bm02Submissions            BM02Submission[]
  currentBM02Submission      BM02Submission?              @relation("CurrentBM02Submission", fields: [currentBM02SubmissionId], references: [id], onDelete: Restrict)
  currentBM02SubmissionId    Int?                         @unique @map("current_bm02_submission_id")
  assignmentDecisions        AssignmentDecision[]
  checkpointEvaluations      CheckpointEvaluation[]
  checkpointSignatureAppeals CheckpointSignatureAppeal[]
  mentorTransfers            MentorTransfer[]
  defenseResultApprovals     DefenseResultApproval[]
  resultPublicationItems     ResultPublicationItem[]
  electronicSignatureEvents  ElectronicSignatureEvent[]
  topicAssignmentDecisionItem TopicAssignmentDecisionItem?
  bm02aRequests              BM02AAdjustmentRequest[]
  titleAdjustmentAppendixItems TitleAdjustmentAppendixItem[]
  bm03Record                 BM03ProgressRecord?
  bm03MeetingEntries         BM03MeetingEntry[]
  bm03StageEvaluations       BM03StageEvaluation[]
  instituteStopReviews       InstituteStopReview[]
  instituteDefenseReviews    InstituteDefenseReview[]

  @@unique([studentId, semesterId])
  @@index([semesterId, periodPolicyVersionId])
  @@map("topic_registrations")
}

model BM01Evaluation {
  id                         Int                           @id @default(autoincrement())
  registrationId             Int                           @map("registration_id")
  attemptNo                  Int                           @map("attempt_no")
  outcome                    BM01Outcome?
  issues                     Json?
  deadlineAt                 DateTime?                     @map("deadline_at")
  notifiedAt                 DateTime?                     @map("notified_at")
  submittedAt                DateTime?                     @map("submitted_at")
  submittedById              Int?                          @map("submitted_by_id")
  submissionId               Int?                          @unique @map("submission_id")
  supersedesId               Int?                          @unique @map("supersedes_id")
  reviewedAt                 DateTime?                     @map("reviewed_at")
  reviewedById               Int?                          @map("reviewed_by_id")
  policyVersionId            Int                           @map("policy_version_id")
  councilId                  Int?                          @map("council_id")
  batchId                    Int?                          @map("batch_id")
  initialOutcome             OutlineInitialOutcome?        @map("initial_outcome")
  attendanceStatus           AttendanceStatus?             @default(PRESENT) @map("attendance_status")
  comment                    String?
  revisionRequirements       String?                       @map("revision_requirements")
  revisionSubmissionId       Int?                          @unique @map("revision_submission_id")
  revisionApprovalStatus     OutlineRevisionApprovalStatus? @default(NOT_REQUIRED) @map("revision_approval_status")
  revisionReviewedAt         DateTime?                     @map("revision_reviewed_at")
  revisionReviewedById       Int?                          @map("revision_reviewed_by_id")
  revisionFeedback           String?                       @map("revision_feedback")
  createdAt                  DateTime                      @default(now()) @map("created_at")
  registration               TopicRegistration             @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  submittedBy                User?                         @relation("BM01SubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  submission                 Submission?                   @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  supersedes                 BM01Evaluation?               @relation("BM01Supersession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy               BM01Evaluation?               @relation("BM01Supersession")
  reviewedBy                 User?                         @relation("BM01ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  policyVersion              PeriodWorkflowPolicyVersion   @relation("BM01PolicyVersion", fields: [policyVersionId], references: [id], onDelete: Restrict)
  council                    Council?                      @relation(fields: [councilId], references: [id], onDelete: Restrict)
  batch                      CouncilResultBatch?           @relation(fields: [batchId], references: [id], onDelete: Restrict)
  revisionSubmission         Submission?                   @relation("BM01RevisionSubmission", fields: [revisionSubmissionId], references: [id], onDelete: Restrict)
  revisionReviewedBy         User?                         @relation("BM01RevisionReviewedBy", fields: [revisionReviewedById], references: [id], onDelete: Restrict)

  @@unique([registrationId, attemptNo])
  @@unique([batchId, registrationId])
  @@index([registrationId, outcome])
  @@index([submittedById])
  @@index([reviewedById])
  @@index([policyVersionId])
  @@index([councilId])
  @@index([batchId])
  @@map("bm01_evaluations")
}

model BM02Submission {
  id                     Int                         @id @default(autoincrement())
  registrationId         Int                         @map("registration_id")
  versionNo              Int                         @map("version_no")
  attemptNo              Int                         @map("attempt_no")
  supersedesId           Int?                        @unique @map("supersedes_id")
  outcome                BM02Outcome                 @default(PENDING_REVIEW)
  issues                 Json?
  content                String?                     @db.Text
  bm01ApprovedTitle      String?                     @map("bm01_approved_title")
  bm02ProposedTitle      String?                     @map("bm02_proposed_title")
  titleChangeReason      String?                     @map("title_change_reason") @db.Text
  studentSnapshot        Json?                       @map("student_snapshot")
  mentorSnapshot         Json?                       @map("mentor_snapshot")
  fileUrl                String?                     @map("file_url")
  fileName               String?                     @map("file_name")
  submittedById          Int                         @map("submitted_by_id")
  submittedAt            DateTime                    @default(now()) @map("submitted_at")
  reviewedById           Int?                        @map("reviewed_by_id")
  reviewedAt             DateTime?                   @map("reviewed_at")
  notifiedAt             DateTime?                   @map("notified_at")
  revisionDeadlineAt     DateTime?                   @map("revision_deadline_at")
  policyVersionId        Int                         @map("policy_version_id")
  registration           TopicRegistration           @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  supersedes             BM02Submission?             @relation("BM02Supersession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy           BM02Submission?             @relation("BM02Supersession")
  currentForRegistration TopicRegistration?          @relation("CurrentBM02Submission")
  submittedBy            User                        @relation("BM02SubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy             User?                       @relation("BM02ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  policyVersion          PeriodWorkflowPolicyVersion @relation("BM02PolicyVersion", fields: [policyVersionId], references: [id], onDelete: Restrict)
  assignmentDecision     AssignmentDecision?
  topicAssignmentDecisionItem TopicAssignmentDecisionItem?

  @@unique([registrationId, versionNo])
  @@index([registrationId, outcome])
  @@index([submittedById])
  @@index([reviewedById])
  @@index([policyVersionId])
  @@map("bm02_submissions")
}

model AssignmentDecision {
  id               Int                         @id @default(autoincrement())
  registrationId   Int                         @unique @map("registration_id")
  bm02SubmissionId Int                         @unique @map("bm02_submission_id")
  decisionNumber   String                      @map("decision_number")
  issuedAt         DateTime                    @map("issued_at")
  effectiveAt      DateTime                    @map("effective_at")
  issuedById       Int                         @map("issued_by_id")
  policyVersionId  Int                         @map("policy_version_id")
  idempotencyKey   String                      @unique @map("idempotency_key")
  createdAt        DateTime                    @default(now()) @map("created_at")
  registration     TopicRegistration           @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  bm02Submission   BM02Submission              @relation(fields: [bm02SubmissionId], references: [id], onDelete: Restrict)
  issuedBy         User                        @relation("AssignmentDecisionIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  policyVersion    PeriodWorkflowPolicyVersion @relation("DecisionPolicyVersion", fields: [policyVersionId], references: [id], onDelete: Restrict)
  amendments       DecisionAmendment[]

  @@index([decisionNumber, issuedAt])
  @@map("assignment_decisions")
}

model DecisionAmendment {
  id                   Int                @id @default(autoincrement())
  assignmentDecisionId Int                @map("assignment_decision_id")
  amendmentNumber      String             @unique @map("amendment_number")
  reason               String             @db.Text
  changes              Json
  signedById           Int                @map("signed_by_id")
  idempotencyKey       String             @unique @map("idempotency_key")
  effectiveAt          DateTime           @map("effective_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  assignmentDecision   AssignmentDecision @relation(fields: [assignmentDecisionId], references: [id], onDelete: Restrict)
  signedBy             User               @relation("DecisionAmendmentSigner", fields: [signedById], references: [id], onDelete: Restrict)

  @@index([assignmentDecisionId, effectiveAt])
  @@index([signedById])
  @@map("decision_amendments")
}

model PeriodWorkflowPolicyVersion {
  id                    Int                    @id @default(autoincrement())
  semesterId            Int                    @map("semester_id")
  version               Int
  policy                Json
  checksum              String
  isActive              Boolean                @default(true) @map("is_active")
  createdById           Int?                   @map("created_by_id")
  createdAt             DateTime               @default(now()) @map("created_at")
  semester              Semester               @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  createdBy             User?                  @relation("WorkflowPolicyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  registrations         TopicRegistration[]
  bm01Evaluations       BM01Evaluation[]       @relation("BM01PolicyVersion")
  bm02Submissions       BM02Submission[]       @relation("BM02PolicyVersion")
  assignmentDecisions   AssignmentDecision[]   @relation("DecisionPolicyVersion")
  checkpointEvaluations CheckpointEvaluation[] @relation("CheckpointPolicyVersion")
  bm04Evaluations       BM04Evaluation[]       @relation("BM04PolicyVersion")
  lockedSemesters       Semester[]             @relation("SemesterLockedPolicy")
  topicAssignmentDecisions TopicAssignmentDecision[] @relation("TopicDecisionPolicyVersion")

  @@unique([semesterId, version])
  @@index([semesterId, isActive])
  @@map("period_workflow_policy_versions")
}

model RegistrationStateHistory {
  id               Int                @id @default(autoincrement())
  registrationId   Int                @map("registration_id")
  fromStatus       RegistrationStatus @map("from_status")
  toStatus         RegistrationStatus @map("to_status")
  fromStateVersion Int                @map("from_state_version")
  toStateVersion   Int                @map("to_state_version")
  actorId          Int                @map("actor_id")
  reason           String?            @db.Text
  reference        Json?
  idempotencyKey   String?            @map("idempotency_key")
  createdAt        DateTime           @default(now()) @map("created_at")
  registration     TopicRegistration  @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  actor            User               @relation("RegistrationStateActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([registrationId, toStateVersion])
  @@index([registrationId, createdAt])
  @@map("registration_state_history")
}

model IdempotencyRecord {
  id             Int                @id @default(autoincrement())
  scope          String
  key            String
  commandHash    String             @map("command_hash")
  registrationId Int?               @map("registration_id")
  response       Json
  createdAt      DateTime           @default(now()) @map("created_at")
  registration   TopicRegistration? @relation(fields: [registrationId], references: [id], onDelete: Restrict)

  @@unique([scope, key])
  @@index([registrationId])
  @@map("idempotency_records")
}

model ManualReviewCase {
  id             Int                @id @default(autoincrement())
  registrationId Int                @map("registration_id")
  status         ManualReviewStatus @default(OPEN)
  reasonCodes    Json               @map("reason_codes")
  evidence       Json?
  openedById     Int?               @map("opened_by_id")
  resolvedById   Int?               @map("resolved_by_id")
  resolution     String?            @db.Text
  createdAt      DateTime           @default(now()) @map("created_at")
  resolvedAt     DateTime?          @map("resolved_at")
  registration   TopicRegistration  @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  openedBy       User?              @relation("ManualReviewOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  resolvedBy     User?              @relation("ManualReviewResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([registrationId, status])
  @@index([status, createdAt])
  @@map("manual_review_cases")
}

model MeetingLog {
  id                 Int      @id @default(autoincrement())
  registrationId     Int      @map("registration_id")
  meetingDate        DateTime @default(now()) @map("meeting_date")
  meetingType        String   @default("LAB") @map("meeting_type")
  studentWorkSummary String   @map("student_work_summary") @db.Text
  nextPlan           String?  @map("next_plan") @db.Text
  supervisorNotes    String?  @map("supervisor_notes") @db.Text
  createdBy          Int      @map("created_by")
