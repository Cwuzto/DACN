  registrationId        Int                 @map("registration_id")
  status                BM04ReviewStatus    @default(PENDING_INSTITUTE_REVIEW)
  submittedAt           DateTime            @default(now()) @map("submitted_at")
  reviewDeadlineAt      DateTime            @map("review_deadline_at")
  extensionCount        Int                 @default(0) @map("extension_count")
  extendedAt            DateTime?           @map("extended_at")
  moreInfoRequestedById Int?                @map("more_info_requested_by_id")
  moreInfoRequestNote   String?             @map("more_info_request_note") @db.Text
  moreInfoResponseNote  String?             @map("more_info_response_note") @db.Text
  decision              String?
  decisionSource        String?             @map("decision_source")
  reviewedById          Int?                @map("reviewed_by_id")
  reviewedAt            DateTime?           @map("reviewed_at")
  reviewReason          String?             @map("review_reason") @db.Text
  idempotencyKey        String?             @unique @map("idempotency_key")
  bm04Evaluation        BM04Evaluation      @relation(fields: [bm04EvaluationId], references: [id], onDelete: Restrict)
  registration          TopicRegistration   @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  moreInfoRequestedBy   User?               @relation("DefenseReviewMoreInfoRequester", fields: [moreInfoRequestedById], references: [id], onDelete: Restrict)
  reviewedBy            User?               @relation("DefenseReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([registrationId])
  @@map("institute_defense_reviews")
}

